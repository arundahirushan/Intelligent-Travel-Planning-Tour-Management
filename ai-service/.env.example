# ai-service/.env.example
# Copy to .env and fill in real values. Never commit .env to git.

# Google Gemini API key for planning
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Authentication secret for internal communication between C# backend and this service
AI_SECRET=dev-secret-do-not-use-in-prod
TOUR_MANAGEMENT_API_URL=http://localhost:5160/api/internal
# Weather API key (e.g. OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key_here

# Port this FastAPI service listens on (default 8000)
PORT=8000
