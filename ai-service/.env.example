# ai-service/.env.example
# Copy to .env and fill in real values. Never commit .env to git.

# LLM provider API key (e.g. OpenAI, Google Gemini, Anthropic)
LLM_PROVIDER_API_KEY=your_llm_api_key_here

# Weather API key (e.g. OpenWeatherMap)
WEATHER_API_KEY=your_weather_api_key_here

# Port this FastAPI service listens on (default 8000)
PORT=8000
